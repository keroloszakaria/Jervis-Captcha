{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "useDefineForClassFields": false, "noEmit": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["web/src/**/*.ts", "web/tests/**/*.ts", "sdk/node/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
