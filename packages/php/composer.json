{
  "name": "jervis/captcha",
  "description": "Offline-first embedded CAPTCHA engine and Laravel integration for Jervis Captcha.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "ext-gd": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "illuminate/cache": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/routing": "^12.0|^13.0",
    "illuminate/session": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/validation": "^12.0|^13.0",
    "illuminate/view": "^12.0|^13.0",
    "php": "^8.2"
  },
  "require-dev": {
    "orchestra/testbench": "^10.8|^11.2",
    "phpunit/phpunit": "^11.5|^12.5"
  },
  "autoload": {
    "psr-4": {
      "Jervis\\Captcha\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jervis\\Captcha\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Jervis\\Captcha\\Laravel\\JervisCaptchaServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "lint": "find src tests config -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
